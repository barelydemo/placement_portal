# Copy this file to .env and adjust as needed.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too-in-production
JWT_ACCESS_TOKEN_HOURS=8

# SQLite database file (relative paths are resolved against the project root)
DATABASE_PATH=placement.db

# Redis (cache + Celery broker/backend)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Cache lifetimes in seconds
CACHE_STATS_TTL=60
CACHE_DRIVES_TTL=60

# --- Notifications -----------------------------------------------------------
# "log"  = write fully-rendered messages to var/notifications.log (no credentials
#          needed; this is the default and what the demo runs on)
# "smtp" = send real email via the SMTP_* settings below
# "chat" = POST to a Google Chat webhook (GOOGLE_CHAT_WEBHOOK_URL)
NOTIFICATION_BACKEND=log

# Fill these in ONLY if you set NOTIFICATION_BACKEND=smtp
MAIL_FROM=placement-cell@ppa.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Fill this in ONLY if you set NOTIFICATION_BACKEND=chat
GOOGLE_CHAT_WEBHOOK_URL=

# --- Background jobs ---------------------------------------------------------
# Remind students about deadlines/interviews this many days ahead
REMINDER_WINDOW_DAYS=2
# Daily reminder run time (24h, Asia/Kolkata)
REMINDER_HOUR=9
REMINDER_MINUTE=0
# Monthly report runs on the 1st at this time
MONTHLY_REPORT_HOUR=6
MONTHLY_REPORT_MINUTE=0

# Seeded admin account (single superuser, created by seed.py)
ADMIN_NAME=Institute Placement Cell
ADMIN_EMAIL=admin@ppa.local
ADMIN_PASSWORD=Admin@123
